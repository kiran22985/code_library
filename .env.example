# Postgres connection string.
#
# Render: the Blueprint sets this automatically from the managed database.
# Local:  start one with Docker, then copy this file to .env.local
#
#   docker run --name codelibrary-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=codelibrary -p 5432:5432 -d postgres:16
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codelibrary

# Only used to build absolute URLs in sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: force TLS on or off for the database connection.
# Detected automatically — no TLS for localhost or Render's internal hostname,
# TLS for public managed hosts. Only set this if detection guesses wrong.
# DATABASE_SSL=true

# Google AdSense. Ads render only in production and only when the client ID is
# set, so leaving these blank keeps ads out of local development.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_LESSON_TOP=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_LESSON_BOTTOM=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_COURSE=0000000000
